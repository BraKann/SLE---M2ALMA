{
    "name": "vscode-dialogue-dsl-v1",
    "description": "The extension specific package",
    "version": "0.0.1",
    "displayName": "dialogue-dsl-v1",
    "type": "module",
    "engines": {
        "vscode": "^1.91.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [{
            "id": "dialogue-dsl-v-1",
            "aliases": ["Dialogue DSL V1", "dialogue-dsl-v-1"],
            "extensions": [".dialogv1"],
            "configuration": "./language-configuration.json"
        }],
        "grammars": [{
            "language": "dialogue-dsl-v-1",
            "scopeName": "source.dialogue-dsl-v-1",
            "path": "syntaxes/dialogue-dsl-v-1.tmLanguage.json"
        }]
    },
    "activationEvents": [
        "onLanguage:dialogue-dsl-v-1"
    ],
    "main": "./out/extension/main.cjs",
    "scripts": {
        "clean": "shx rm -fr *.tsbuildinfo out syntaxes",
        "vscode:prepublish": "npm run build",
        "build:prepare": "shx mkdir -p ./syntaxes/ && shx cp -f ../language/syntaxes/dialogue-dsl-v-1.tmLanguage.json ./syntaxes/dialogue-dsl-v-1.tmLanguage.json",
        "build": "npm run build:prepare && tsc -b tsconfig.json && node esbuild.mjs",
        "build:clean": "npm run clean && npm run build",
        "watch": "npm run build:prepare && concurrently -n tsc,esbuild -c blue,yellow \"tsc -b tsconfig.json --watch\" \"node esbuild.mjs --watch\""
    },
    "dependencies": {
        "dialogue-dsl-v-1-language": "0.0.1",
        "vscode-languageclient": "~10.1.0",
        "vscode-languageserver": "~10.1.0"
    },
    "devDependencies": {
        "@types/vscode": "~1.91.0",
        "concurrently": "~10.0.4",
        "esbuild": "0.28.2"
    },
    "vsce": {
      "dependencies": false
    }
}
